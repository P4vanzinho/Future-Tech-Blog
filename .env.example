# Use "local" for offline development or "r2" to use Cloudflare R2.
MEDIA_STORAGE=local

# Local SQLite (default) or Turso libSQL URL.
DATABASE_URL=file:./payload.db
# Required when DATABASE_URL points to Turso (libsql://...).
DATABASE_AUTH_TOKEN=

# Required when MEDIA_STORAGE=r2.
R2_BUCKET=future-tech-blog-media-dev
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Required in production. Never expose this with NEXT_PUBLIC_.
PAYLOAD_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed defaults (used by npm run seed)
SEED_ADMIN_EMAIL=admin@futuretech.local
SEED_ADMIN_PASSWORD=change-me-in-production

# Required together with --force to seed production databases.
ALLOW_PROD_SEED=false
